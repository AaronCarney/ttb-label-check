# Credentials: never committed
.env
.env.*
!.env.example
*.key
*.pem

# Local Claude Code settings and session state
.claude/settings.local.json
.baton/

# OS / editor
.DS_Store
Thumbs.db
*:Zone.Identifier
*.swp
.vscode/
.idea/

# Logs and scratch
*.log
*.tmp

# Local environment
.venv/
.env
__pycache__/
*.pyc

# Tool caches. Each writes an ignore file inside itself, so a tree that has run
# pytest or ruff looks clean only until one of those is deleted.
.pytest_cache/
.ruff_cache/

# Frontend dependencies: installed with `pnpm install`, never committed
frontend/node_modules/

# Frontend build output: regenerated by `pnpm build` (tsc -b && vite build).
# The .ts sources are tracked; a committed compiled copy also shadows them,
# because Vite and Tailwind both resolve a .js config ahead of its .ts source.
frontend/*.config.js
frontend/*.config.d.ts
frontend/*.tsbuildinfo
!frontend/postcss.config.js

# Wrangler's local build cache for the edge Worker.
edge/.wrangler/

# Coverage's own data file and the Cobertura report CI uploads as an artifact.
.coverage
.coverage.*
coverage.xml
htmlcov/

# mutmut builds a mutated copy of the tree here on every run.
mutants/
.mutmut-cache

# Latency rows the deploy harness writes, one file per run
# (tests/test_deploy_healthz.py). A measurement of a service at a moment, not
# source; the figures worth keeping are quoted in README.md and docs/.
artifacts/

# Label images fetched from the Public COLA Registry for evaluation
eval/data/
