# === ttb-label-check — inventory of every environment variable the app reads ===
# Loaded by app/config.py (Pydantic Settings), which is the only module that
# reads the environment. Copy to .env and fill secrets locally; .env is gitignored.

# Which reader turns a label image into fields (docs/decisions.md#0005). `local`
# runs a CPU OCR engine inside the app, needs no key and makes no outbound call,
# and is the default; `cloud` calls a hosted vision model and needs OPENAI_API_KEY.
VISION_MODE=local

# Required only when VISION_MODE=cloud: the hosted reader authenticates with it.
# Leave blank for the default local reader.
OPENAI_API_KEY=

# Pinned model snapshot for the cloud reader. Pinning keeps its readings
# reproducible; changing it means the recorded responses have to be regenerated.
LLM_MODEL_SNAPSHOT=gpt-4o-2024-08-06

# Versioned prompt identifier. Changing it also invalidates recorded responses.
PROMPT_VERSION=v1

# How many labels in a batch are read ahead of the one on screen.
LOOKAHEAD_K=3

# How many CPU threads the local OCR reader may use. The default matches the
# deploy target's core count (Cloud Run, 4 vCPU — decision 0025), so a
# developer's machine reads a label the way the deployed product does. The
# reader clamps this to the machine's own core count: onnxruntime drops an
# out-of-range thread count without an error and then uses every core.
OCR_NUM_THREADS=4

# Truthy gates the development-only /eval route.
DEV_MODE=

# Optional OTel collector endpoint; unset means JSON-line logs on stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional logging level (default INFO). One of DEBUG/INFO/WARNING/ERROR/CRITICAL.
LOG_LEVEL=INFO

# Where the YAML rule pack is read from. Defaults to `rules/` beside the
# application, which is what a clone and the container both want; set it only to
# point the engine at a pack somewhere else.
RULES_ROOT=

# The commit the running process was deployed from. Set by scripts/deploy.sh, not
# by hand: a working tree is not a commit, and a wrong value here is worse than
# none. Unset, /api/health reports the commit as "unknown".
GIT_COMMIT=
