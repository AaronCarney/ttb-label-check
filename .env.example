# === ttb-label-check — inventory of every environment variable the app reads ===
# Loaded by app/config.py (Pydantic Settings), which is the only module that
# reads the environment. Copy to .env and fill secrets locally; .env is gitignored.

# Which reader turns a label image into fields (docs/decisions/0005). `local`
# runs a CPU OCR engine inside the app, needs no key and makes no outbound call,
# and is the default; `cloud` calls a hosted vision model and needs OPENAI_API_KEY.
VISION_MODE=cloud

# Orchestrator backend. Values: openai | anthropic.
# Only `openai` is ever run live here; the `anthropic` value exists so the
# backend stays swappable, and it is exercised by mocked tests only.
ORCHESTRATOR_BACKEND=openai

# Required: the cloud reader and the openai orchestrator both use it.
OPENAI_API_KEY=

# Never set here. `AnthropicStrictOrchestrator` exists to show the backend is
# swappable and is exercised only by respx-mocked unit tests. Leave it blank in
# every environment.
ANTHROPIC_API_KEY=

# Orchestrator-on-the-hot-path master switch. Default OFF: every hard
# requirement in the brief is a deterministic rule check, and Marcus flagged
# outbound-LLM traffic as firewall-hostile. The seam is wired — the model may
# not touch outcome, severity or reason code — but the model does not run by
# default. Set to 1 to enable.
ORCHESTRATOR_ENABLED=

# Pinned model snapshot. Pinning keeps results reproducible; changing it means
# the recorded responses have to be regenerated.
LLM_MODEL_SNAPSHOT=gpt-4o-2024-08-06

# Versioned prompt identifier. Changing it also invalidates recorded responses.
PROMPT_VERSION=v1

# How many labels in a batch are read ahead of the one on screen.
LOOKAHEAD_K=3

# Truthy gates the development-only /eval and
# /batches/{id}/labels/{lid}/calls routes.
DEV_MODE=

# Optional OTel collector endpoint; unset means JSON-line logs on stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional logging level (default INFO). One of DEBUG/INFO/WARNING/ERROR/CRITICAL.
LOG_LEVEL=INFO
